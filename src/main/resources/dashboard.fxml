<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="820.0" prefHeight="620.0"
            style="-fx-background-color: linear-gradient(to bottom, #87CEEB, #f5deb3);"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="boundary.DashboardView">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #111111;">
            <padding>
                <Insets top="10" right="15" bottom="10" left="15"/>
            </padding>
            <Button text="Home"/>
            <Button text="Dashboard"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="logoutButton" text="Log Out" onAction="#onLogoutClicked"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="15">
            <padding>
                <Insets top="25" right="20" bottom="20" left="20"/>
            </padding>

            <Label fx:id="welcomeLabel" text="Welcome to Seabank"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label fx:id="balanceLabel" text="P 5,550.00"
                   style="-fx-font-size: 42px; -fx-font-weight: bold;"/>
            <Label text="ACCOUNT BALANCE" style="-fx-font-size: 12px;"/>

            <GridPane hgap="15" vgap="15" maxWidth="650"
                      style="-fx-background-color: white; -fx-background-radius: 10;">
                <padding>
                    <Insets top="25" right="25" bottom="25" left="25"/>
                </padding>
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>

                <!-- Deposit -->
                <VBox alignment="CENTER" spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="↓" style="-fx-font-size: 40px;"/>
                    <Label text="Deposit" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Deposit money into your account."/>
                    <Button fx:id="depositButton" text="GO" onAction="#onDepositClicked"/>
                </VBox>

                <!-- Withdraw -->
                <VBox alignment="CENTER" spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="↑" style="-fx-font-size: 40px;"/>
                    <Label text="Withdraw" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Withdraw money from your account."/>
                    <Button fx:id="withdrawButton" text="GO" onAction="#onWithdrawClicked"/>
                </VBox>

                <!-- Transfer -->
                <VBox alignment="CENTER" spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="⇄" style="-fx-font-size: 40px;"/>
                    <Label text="Transfer" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Send money to another account."/>
                    <Button fx:id="wireButton" text="GO" onAction="#onWireClicked"/>
                </VBox>

                <!-- Account History -->
                <VBox alignment="CENTER" spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="≡" style="-fx-font-size: 40px;"/>
                    <Label text="Account History" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="View your transaction records."/>
                    <Button fx:id="historyButton" text="GO" onAction="#onHistoryClicked"/>
                </VBox>
            </GridPane>
        </VBox>
    </center>
</BorderPane>