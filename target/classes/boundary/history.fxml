<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="760.0" prefHeight="560.0"
            style="-fx-background-color: linear-gradient(to bottom, #f4f8fc, #cfe3f3);"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="boundary.HistoryView">

    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #14407d;">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Label text="Seabank" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Back to Dashboard" onAction="#onBackClicked"
                    style="-fx-background-color: #2a62b5; -fx-text-fill: white; -fx-background-radius: 5;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="18.0">
            <padding>
                <Insets top="25" right="30" bottom="20" left="30"/>
            </padding>

            <Label text="Transaction History"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #14407d;"/>

            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="180.0"/>
                    <TableColumn fx:id="descColumn" text="Description" prefWidth="260.0"/>
                    <TableColumn fx:id="amountColumn" text="Amount (P)" prefWidth="140.0"/>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="100.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <Button text="Back" onAction="#onBackClicked" prefWidth="220.0"
                    style="-fx-background-color: #14407d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>
        </VBox>
    </center>
</BorderPane>